# =========================================================
# CineBook backend environment configuration
# Copy this file to `.env` and adjust the values.
# Never commit the real `.env` file.
# =========================================================

# --- Core -------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------
# Options: sqlite (default) | postgres
DB_ENGINE=sqlite
# PostgreSQL only (used when DB_ENGINE=postgres):
DB_NAME=cinebook
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- CORS / CSRF ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False

# --- Throttling -------------------------------------------
THROTTLE_ANON=100/min
THROTTLE_USER=300/min
THROTTLE_AUTH=20/min
THROTTLE_PASSWORD_RESET=5/hour

# --- Email ------------------------------------------------
# Development uses the console backend (prints emails to the terminal).
# For production use smtp and set EMAIL_HOST/EMAIL_HOST_USER/...
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CineBook <no-reply@cinebook.local>

# --- Misc -------------------------------------------------
TIME_ZONE=UTC
FRONTEND_RESET_URL=http://localhost:5173/reset-password
SEAT_LOCK_TTL_MINUTES=10
PAYMENT_GATEWAY=mock
